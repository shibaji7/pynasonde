# Template for local credentials. Copy to .env (git-ignored) and fill in:
#     cp .env.example .env
# Loaded automatically by tests/conftest.py and examples/digisonde/didbase_test.py
# (scripts that read os.environ directly, e.g. the skymap examples, need these exported:
#   set -a; source .env; set +a).
# Existing environment variables take precedence over values in this file.
# Live tests (network) are opt-in: `make test-live` (or set RUN_LIVE_TESTS=1 here).

# DIDBase (GIRO) Firebird database, used by pynasonde.digisonde.didbase
DIDBASE_URL=jdbc:firebirdsql://didbase.giro.uml.edu/didb
DIDBASE_USER=
DIDBASE_PASSWORD=
DIDBASE_ROLE=COMMON

# DriftBase (drift / skymap data) Firebird database, used by pynasonde.digisonde.driftbase.
# It has been observed to accept the same username/password as DIDBase.
DRIFTBASE_URL=jdbc:firebirdsql://129.63.134.45/drift
DRIFTBASE_USER=
DRIFTBASE_PASSWORD=
DRIFTBASE_ROLE=COMMON
